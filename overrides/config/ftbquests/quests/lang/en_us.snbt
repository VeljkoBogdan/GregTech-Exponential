	quest.53944155699FAB6E.quest_desc: [
		"&lWelcome to &bGregTech: Exponential&r!&r"
		""
		"GT:E is a mod with exponentially increasing difficulty. You will start off easy, with &amost early recipes being way simpler&r than before. After that, &5each tier will increase in difficulty&r."
		""
		"This pack is meant to boost you into the mid and late game, and challenge your infrastructure and problem solving, without the tedium."
	]
	quest.5BE07F247E87FAF0.quest_desc: [
		"You can find rubber trees all over the world, which drop sticky resin when chopped down. This sticky resin can be turned into rubber ingots, and then rubber sheets, using hammers."
		""
		"&bPS you can spam crouch to quickly grow the saplings.&r"
	]
	quest.5BE07F247E87FAF0.title: "Rubbery"
